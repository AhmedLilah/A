// For each / range based for loop
// -----------------------------------------------------------------
// iterating through the arry elements.
array :: [10, 20, 30, 40];
for value in array {
        println("${value}");
}

// iterating through the arry elements and the index.
array :: [10, 20, 30, 40];
for value, index in array {
        println("${index}, ${value}");
}

// iterating through the arry elements by value.
aos :: [Vec3{x=0, y=0, z=0}, Vec3{x=1, y=1, z=1}];
for $value in aos {
        print("${value.x}");
}

// iterating through the arry elements by value and index.
for $value, index in [Vec3{x=0, y=0, z=0}, Vec3{x=1, y=1, z=1}] {
        print("${index}, ${value.x}");
}

// iterating through the arry elements by pointer.
aos :: [Vec3{x=0, y=0, z=0}, Vec3{x=1, y=1, z=1}];
for @ value in aos {
        print("${value.x}");
}

// iterating through the arry elements by pointer.
for @ value, index in [Vec3{x=0, y=0, z=0}, Vec3{x=1, y=1, z=1}] {
        print("${index}, ${value.x}");
}






