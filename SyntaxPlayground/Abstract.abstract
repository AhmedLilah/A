// Operators
// 	Logical Operators
// 		Unary Logical Operators
buf			// Boolean double negation operator. same as the value. buffered in hardware scope. ??
not			// Boolean negation operator.
// 		Binary Logical Operators
and 			// Checks if both of the expressions are true and returns a Boolean.
or  			// Checks if either of the expressions are true and returns a Boolean.
xor			// Checks if only one of the expressions is true and returns a Boolean.
nand			// Checks if both of the expressions are false and returns a Boolean.
nor			// Checks if either of the expressions is false and returns a Boolean.
xnor			// Checks if only one of the expressions is false and returns a Boolean.

// 	Bitwise Operators
// 		Unary Bitwise Operators
~			// Boolean invert.
!~			// Boolean buffer. ??

// 		Binary Bitwise Operators
&			// Boolean and.
| 			// Boolean or.
^			// Boolean xor.
<<			// Arithmetic left shift
>> 			// Arithmetic right shift
<|, |>			// should there be a logical shift operators?



// 	Arithmetic Operators
// 		Unary Arithmetic Operators
++ 			// Increment operator.
--			// Decrement operator.

// 		Binary Arithmetic Operators
+			// Addition operator.
-			// Subtraction operator.
*			// Multiplication operator.
/			// Division operator.
\			// Remainder operator.
%			// Modulus operator.
**			// Power Operator.

// 	Comparison Operators
==			// Equality.
!=			// Inequality.
<			// Less than.
<=			// Less than or equal.
>			// Greater than.
>=			// Greater than or equal.
			// place holder for the rest.

// 	Assignment Operators
:			// Type declaration/compile time assignment operator.
=			// Variable assignment operator.

// 	Special Operators
,			// Expression separation operator, Function parameters separation operator.
;			// Expression termination operator.
.			// Member access operator, Context capture operator.
..			// Range operator.
...			// Variadic parameters identifer, Parameter packing/unpacking operator.
->			// Functional block return/output operator.
_			// Don't care/Anything/Default/Ignore.


// Default Types
// 	Hardware Types
//		Digital Types
time, realtime		// Represents the time in the circuit simulation/ real time passed.
			// Should this even be a thing or just make these functions in libraries.
bit, byte		// For consistency between Software and Hardware code and takes the values
			// 	 _ (don't care)
			// 	 0
			// 	 1
			// 	 H (weak high), Pull Up.
			// 	 L (weak low), Pull down.
			// 	 U (undefined).
			// 	 W (weak).
			// 	 X (unknown).
			// 	 Z (high impedance).



// Boolean Types
// 	A type than handles logical expression true or false.
// 	This type should be handled in the smallest amount of memory the architecture supports.
bool

// Integral Types
//	Integral types do not support bit wise operation.

//	Two's complement based singed integer types .
//		Further improvement could be to support any number of bits.
s8
s16
s32
s64
s128			// should this be a thing and should we have more?


//	Unsinged integer types.
//		Further improvement could be to support any number of bits.
u8
u16
u32
u64
u128			// should this be a thing and should we have more?

//	Architecture based integer types.
ssize
usize

// 	Floating Point Types
//		IEEE 754 based floating point.
f16
f32
f64
f80
f128

// Character Types
rune
char
c8
c16
c32

// String Types
string
ascii
utf8
utf16
utf32

// Absent Of Types
void

// Values
// Undefined
_














