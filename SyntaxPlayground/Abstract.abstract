// 	example
TimeLineTrackType :: flag u8 {
	NONE	: 0B0000_0000;
	AUDIO 	: 0B0000_0001;
	VIDEO	: 0B0000_0010;
	_
}

timelineS : [] TimeLineTrack;

for timeline in timelines {
	TIME_LINE_TYPE_IF_CASE :: if timeline {
		case .AUDIO {
			gui.showAudioTimelineSymbol();
			nobreak TIME_LINE_TYPE_IF_CASE;
		}

		case .VIDEO {
			gui.showAudioTimelineSymbol();
			unbreak TIME_LINE_TYPE_IF_CASE;
		}
	}
}








