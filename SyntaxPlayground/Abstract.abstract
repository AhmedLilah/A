// Replaces the initial block.
main :: (_) {
	// the code here runs only at the start of the simulation
}

// Replaces the always block.
main :: () {
	// the code here runs without any triggers
}

// Replaces the always block with a trigger
main :: (anyEdge(A) | positiveEdge(B) | negativeEdge(C) | anyEdge(D) | anyEdge(E) | anyEdge(F)) {
	// the code here runs only of any of the triggers listed in the main funciton happens
}









