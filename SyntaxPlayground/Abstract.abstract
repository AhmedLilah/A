// if case statements
// -----------------------------------------------------------------
//	Matches the value of the variable with the case.
//	a smart switch-case and match like statement but more linguistically sound
SchematicInstances :: enum union {
	symbol 		: types.Symbol;
	wire		: types.Wire;
	joint 		: types.SolderJoint;
	spiceCommand	: types.SpiceCommand;
	lable		: types.Lable;
	comment		: types.Comment;
	hint		: types.Hint;
	option		: types.Option;
	link		: tyhpe.Link;
}

schInst : SchematicInstances;
ignoredInstancesCount : sszie;

if schInst {
	// named case
	// 	this nameing could be applied to the cases wher a range of values is used
	case symbol : .Symbol {
		validate(symbol.primatives);
		transformt(symbol.position);
	}

	// destructuring named values
	// 	we don't want to keep doing the symbol.member access pattern
	case .sybmol : .Symbol {
		validate(primatives);
		transformt(position);
	}
	// this is equivalent to
	// 	or at least  it should be.
	case symbol : .Symbol {
		. :: sybmol;
		validate(primatives);
		transformt(primatives);
	}

	// but what if we want to rename the members inside the value?
	// 	is this even usefull?
	// 	the example in rust does make sense as the value itself wan't named.
	//	I dont' like this yet.
	case .prim, .pos : .Symbol {

	}

	// unnamed case
	case .wire {
		reduce(wire.points);
	}

	// tag and value pair?
	// 	the idea is the tagged union is a value of the tage and a value of the type underneath it.
	// 	so why not match specific cases where we want tage with a specific value.
	// 	does this syntax collide with any other cases?
	//
	case .{.option, .Editable} {
		schematic.log("this file is editable\n");
	}
	// this is the named version of the smae thing
	// 	this wil take the name of the case wher the tagged union is of the type option and value is
	// 	the named type and we are setting the editable option to false.
	case editableOption : .{.option, .Editable} {	// the .{} syntax is the assignment to expected type of the tagged union pair of values.
		editableOptin = false;
	}


	// in case the case statement have only one statement then we could just ignore the curly braces
	case joint : .joint remove(@ joint);

	// jointly named cases
	case ingnoredInstance : .spiceCommand, lable {
		print("Ignored the instance at position {}\n", ignoredInstance.pos);
		ignoredInstancesCount++;
	}

	// multiple unnamed cases
	// 	if there is not statments to be executed you can just start the next case.
	case .comment, hint {
		// doing nothing at all.
	}

	case _ {
		print("this is not something to be bothered with\n");
	}
}


number : s64;

if number {
	case 0 {
		print("You are a failure\n");
	}

	case dissappointment : 1..5 {
		print("You got {}! you're a dissappointment\n", dissappointment);
	}

	case 9, 10 {
		print("You could be better\n");
	}

	case _ {
		print("where did you lose the grades\n");
	}
}

