// Parameter path declaration and passing convention
// -----------------------------------------------------------------
//      Parameter-Passing Markers
//                      : default is definded by compiler for performance reasons.
//              @       : forces passing by address.
//              $       : forces passing by value.
//      Parameter-Direction Markers
//                      : Default is input for input parameters and output for output parameters.
//              input   : you can only read the value of the parameter.
//              output  : you can only set the value of the parameter.
//              inout   : you can read/set the value of the parameter.
treeSort :: (tree : @ inout Node, sortingFunction : () -> ()) {
        // implementation
}

//      Should all input types be input? (yes)
//      Should all output output types be output? (yes)
//      What does that mean in terms of hardware? (if the previous is good then it's gonna be ok for hardwaer otherwise we can make a different behavior)

// explicitly defining the adress part.
// this could be fine but it's going to be redundant.
removeAtIndex :: (container : @ inout Container, index : ssize) {
	// ...
}

// implicitly defined address part.
// this is very important for the hardware side.
removeAtIndex :: (container : inout Container, index : ssize) {
	// ...
}


// These affect only the value that is passed to the function not the original
// but if that is true that means that the compiler isn't allowed to decide
//      the best way to pass the parameters to the function
// if we think that explicit passing solves this we still cant make a decision
//      in the original implicit case with output and inout direction spacifires
// ---------------------------------------------------------------
removeAtIndex :: (container : input  Container, index : ssize) {}

// this case is a problem.
//      is essential to hardware mode.
//      could be defined as illegal or defaulted to @ output by compiler.
removeAtIndex :: (container : output Container, index : ssize) {}

// this case is a problem.
//      is essential to hardware mode.
//      could be defined as illegal or defaulted to @ inout by compiler.
removeAtIndex :: (container : inout  Container, index : ssize) {}


// this is ok since we already know that it's passed by value so whatever the
//      directionality of the input it's happening to the local copy.
// ---------------------------------------------------------------
removeAtIndex :: (container : $ input  Container, index : ssize) {}

// should be illegal in software.
//      can't have an output variable that is passed by copy.
removeAtIndex :: (container : $ output Container, index : ssize) {}

// should be illegal in software.
//      can't have an inout variable that is passed by copy.
removeAtIndex :: (container : $ inout  Container, index : ssize) {}


// this is ok since we already know that it's passed by pointer so whatever the
//      directionality of the input it's happening to the original.
// ---------------------------------------------------------------
removeAtIndex :: (container : @ input  Container, index : ssize) {}
removeAtIndex :: (container : @ output Container, index : ssize) {}
removeAtIndex :: (container : @ inout  Container, index : ssize) {}


// all of this should be illegal
//      directionl specifiers can't be applied to the highest level parameter-passing markers
//	still to be decided.
// ---------------------------------------------------------------
removeAtIndex :: (container : input  @ Container, index : ssize) {}
removeAtIndex :: (container : output @ Container, index : ssize) {}
removeAtIndex :: (container : inout  @ Container, index : ssize) {}

// this is ok
removeAtIndex :: (container : @ input  @ Container, index : ssize) {}
removeAtIndex :: (container : @ output @ Container, index : ssize) {}
removeAtIndex :: (container : @ inout  @ Container, index : ssize) {}











