// Scope Embedding
// -----------------------------------------------------------------
// Named module
basic :: #import("Software/basics.a");		// Loads a module an assign it to a compile-time name.
basic.print("Hello, World!");			// Using functions from the module.

// Embedded Module
. :: #import("Software/basics.a");		// Loads the module and put all of it's insides int he current file scope
print("Hello, World!");				// Using functions from the module.










// Types Composition
// -----------------------------------------------------------------
Adress :: {
	building number : String;
	street          : String;
	city            : String;
	governance      : String;
	country         : String;
}

PersonalInformation :: {
	name            : String;
	salary          : s32;
	.               : Adress;
}

person : PersonalInformation = {
	name           = "Mohamed",
	salary         = 2K,
	buildingNumber = "1",
	street         = "main",
	city           = "New Cairo",
	governance     = "Cairo"
	country        = "Egypt"
};










// Function Parameter Decomposition
// -----------------------------------------------------------------
RGBColor :: {
	R, G, B : u8;
}

modifyBrightness :: (. : inout structName, m : f32) {
	R = xx R * m;
	G = xx G * m;
	B = xx B * m;
}

backGroundColor : RGBColor = {0h1a, 0h1a, 0h1a};

modifyBrightness(backGroundColor, 1.5);











// Automatically Invoked Struct Member Defining Functions
// -----------------------------------------------------------------
// 	This is a way to use the deconstructing embedding operator
// 	to auto invoke functions that return a type that is then used
// 	as a struct member and directly accessed.
EntityType      :: enum u8 {
        Entity;
        Door;
        Human;
}

Entity          :: {
        type    :  EntityType;
        vTable  :  [] @;
        x, y, z :  f32;
        .       :: (. : @ Entity) -> @ EntityVTable {
                return vTables[entity.type];
        }
}

DoorState       :: enum u8 {
        Closed;
        Open;
}

Door            :: {
        .       :  @ Entity;
        state   := DoorState.Closed;
}

Human           :: {
        .       :  @ Entity;
        name    := "unnamed";
}

EntityVTable    :: {
        init    :: (. : @ Entity) {}
        print   :: (. : @ Entity) {}
}

DoorVTable      :: {
        init    :: (. : @ Door) {
                x, y, z = 3.1415;
                state = .Open;
        }
        print   :: (. : @ Door) {
                print("Door:\n");
                print("\tis at: ({}, {}, {})\n", x, y, z);
                print("\tis   : {}\n", state);
        }
}

HumanVTable     :: {
        init    :: (. : @ Human) {
                x, y, z = 3.1415;
                name = "Ahmed S. Lilah"
        }
        print   :: (. : @ Humand) {
                print("Human:\n");
                print("\tis at: ({}, {}, {})\n", x, y, z);
                print("\tname : \"{}\"\n", name);
        }
}

entityVTable    : EntityVTable;
doorVTable      : DoorVTable;
humanVTable     : HumanVTable;

vTables : [3] @ EntityVTable = {auto @enityVTable, auto @doorVTable, auto @humanVTable};

door    := alloc(DoorEntity);
human   := alloc(HumanEntity);

door.print(door);
door.init(door);
door.print(door);

human.print(human);
human.init(human);
human.print(human);










