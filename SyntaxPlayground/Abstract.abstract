/*                                                     FLAG                                                     */
/*                                                                                                              */
/****************************************************************************************************************/





// Simple Flag
// -----------------------------------------------------------------
cpu_flags :: flag u8 {
	NONE :: 0;            // 0b0000_0000
	CARRY;                // 0b0000_0001
	ZERO;                 // 0b0000_0010
	NEGATIVE;             // 0b0000_0100
	OVERFLOW;             // 0b0000_1000
	PARITY;               // 0b0001_0000
	AUXILIARY;            // 0b0010_0000
	TRAP;                 // 0b0100_0000
	DIRECTION;            // 0b1000_0000
}


// Non-exhaustive flag
// -----------------------------------------------------------------
PortFlags :: flag u8 {
        Off;                    // 0B0000_0000

        // Directionality       // 0B0000_XXXX
        Input;                  // 0B0000_0001
        Output;                 // 0B0000_0010
        InOut;                  // 0B0000_0100
        HighZ;                  // 0B0000_1000

        // Port Type
        Digital;                // 0B0001_0000
        Analog;                 // 0B0010_0000
        PWM;                    // 0B0100_0000
        Clk;                    // 0B1000_0000

        // Making the flag non-exhuastive to allow other extentions in the future.
        _;
}

analogInput :: PortFlags.Input | .Analog;






/****************************************************************************************************************/
/*                                                                                                              */
/*                                                    UNION                                                     */
/*                                                                                                              */
/****************************************************************************************************************/

// Union
// -----------------------------------------------------------------
// 	union is a sum type. where only one of the members are stored at a time although the size is equal to that of the biggest type.
//	Union Declaration
UnionName :: union {
	memberName : type;
	memberName : type;
}


// Tagged Union
// -----------------------------------------------------------------
// 	Is done by using the 'enum' or 'flag' keywords before the 'union' keyowrd like:
Result :: enum union {
	Ok  : f32;
	Err : math.Error;
}

Result :: flag union {
	Ok  : f32;
	Err : math.Error;
}

// You can define the tag size after the enum and before the union keywords.
Result :: enum u8 union {
	Ok  : f32;
	Err : string;
}


//      By default the tagged union type is zero initialized with the zero initialization
//      value of the enum to represent the null state or no value present.
//      However, In the case that the programmer decided to do it their own for whatever
//      reason, they could just use the zero value for the null state or another value and
//      and just make the zero value undefined.
//      The more advanced way of assigning to a tagged union is to just recognize
//      that it's just a sturct that contains a tag and the raw union
DrawableInstance  : enum u8 union {
        None      : 0, _;                       // this manually defines a "None" default state that only have an enum and no union member type.
        None      : 0, void;                    // this is similar to the previous one but this defines the union member type to be void.
        Symbol    : 1, SymbolInstance;          // this assigns the value to the enum tag and a type for the union.
        Wire      : _, WireInstance;            // this explicitly tells it that the tag is infered and the type is also explicitly given
        Primative : PrimativeInstance;          // this automatically inferes the tag value and the type is explicitly given
}


// Note:
//	Should we have defulat initialization states for the union types also?
//      Or should we use the assignment syntax?
//      	this will difenatly annoy some people including mysefl as it
//      	looks very similar to the assignment of default value struct
//      	members
TU : enum u8 union {
        X : f32 = 0;
        Y : s32 = 1;
        Z : f64 = 2
}


// Question:
//	Should we make the underlying type in an enum, union, tagged-union
// 	, and flag always a must? (probably no)
//	reason is: make the simple most obvious things fast and easy to do.







// Using ... for vaiadic argument parameters construction and destruction
// -----------------------------------------------------------------
//      enternally this is similar to passing an array.
add :: (A : ... f32, B : ... f32) (sum : f64 = 0) {
        for idx := 0 : (A.size-1) {
                sum = A[idx] + B[idx];
        }
        return;
}

addedList := add(A = 1, 2, 3, 4, 5, B = 5, 4, 3, 2, 1);
// addedList => {6, 6, 6, 6, 6}





