#import("basic");

main :: () {
        // local constant
        X, Z :: 5;

        // function
        function :: (A : f64, B : f64, X : f64, Z : f64) -> (Y : f64) {
                Y = (A + B) / X * Z;
        }

        // closure syntax 1
        // implicit capture
        closure :: (A : f64, B : f64) => (Y : f64) {
                Y = (A + B) / X * Z;
        }

        // closure syntax 2
        // explicit capture 1
        closure :: (A : f64, B : f64) -> (Y : f64) [@ X, $ Z] {
                Y = (A + B) / X * Z;
        }

        // closure syntax 3
        // explicit capture 2
        closure :: (A : f64, B : f64) -> (Y : f64) [. : @ X, . : $ Z] {
                Y = (A + B) / X * Z;
        }

        // closure syntax 4
        // explicit capture 3
        closure :: (A : f64, B : f64) -> (Y : f64) using @ X, $ Z {
                Y = (A + B) / X * Z;
        }

        // test variables
        A, B :: 5;

        res1 :: function(A, B, X, Z);
        res2 :: closure(A, B);

        print("res1 : {}, res2 : {}", res1, res2);
}










vectorizedComputation :: (A : @ [16] f32, B : @ [16] f32, C : @ [16] f32) -> (Sum : [16] f32) {
        // Meta Assembly
        #asm("x86_64") {
                vmovdqu32       zmm0, A;                // Load 16 f32 values from A
                vmovdqu32       zmm1, B;                // Load 16 f32 values from B
                vmovdqu32       zmm2, C;                // Load 16 f32 values from C
                vfmadd231ps     zmm0, zmm1, zmm2;       // Sum = A * B + C
                vmovdqu32       @Sum, zmm0;             // Store result at the address of Sum
        }
}













// Compiler intrinsics for vector operations.
intrinsics :: namespace {
        intel :: namespace {
                x86_64 :: namespace {
                        avx_512 :: namespace {
                                packed_16_float_multiply_add :: (A : @ [16] f32, B : @ [16] f32, C : @ [16] f32) -> (Sum : [16] f32) {
                                        // Meta Assembly
                                        #asm("x86_64") {
                                                vmovdqu32       zmm0, A;                // Load 16 f32 values from A
                                                vmovdqu32       zmm1, B;                // Load 16 f32 values from B
                                                vmovdqu32       zmm2, C;                // Load 16 f32 values from C
                                                vfmadd231ps     zmm0, zmm1, zmm2;       // Sum = A * B + C
                                                vmovdqu32       @Sum, zmm0;             // Store result at the address of Sum
                                        }
                                }
                        }
                }
        }
}





















// UFCS Vs Methods
BW :: f32;

RGB :: {
        r, g, b : f32;
}

// Normal function
to_BW :: (. : RGB) -> (bw : BW) {
        bw = (0.2126*R + 0.7152*G + 0.0722*B);
}

invert :: (. : BW) -> (bw : BW) {
        bw = 1.0 - bw;
}

// Go like method
to_BW :: (. : RGB) () -> (bw : BW) {
        bw = (0.2126*R + 0.7152*G + 0.0722*B);
}

invert :: (. : BW) () -> (bw : BW) {
        bw = 1.0 - bw;
}


main :: () {
        color_white_rgb :  RGB;
        fucntionCall    := invert(to_bw(rgb));          // calling nested functions isn't that intuitive
        mehtodCall      := rgb.to_bw().invert();        // calling methods makes understanding the code much more fun
}