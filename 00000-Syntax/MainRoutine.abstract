#import("iostream");
#import("format");
#import("print");
#import("ranges");

lexer  :: #include("lexer.abstract");
parser :: #include("parser.abstract");

runCompilerRoutine :: () {
        sourceCode :: 
                "main :: () {"
                "        x := 42;"
		"        "
		"        for {"
                "                continue;"
                "                break;"
                "        }"
		"        "
                "        if x"
                "        case 0 {"
                "                x = 10;"
                "        }"
                "        case x >= 1 {"
                "                x = 0;"
                "        }"
		"        "
                "        for 06 {"
                "		 print(\"X : {x}\");"
                "        }"
		"        "
		"	 `\\sum_{{start}}^{{stop}} {{span}}` :: (start : s64, stop : s64, span : [_]_) -> sum : s64 {"
		"		 sum = 0;"
		"		 for i in start..stop {"
		"			 sum += span[idx];"
		"		 }"
		"	 }"
		"        "
                "}"
        ;
        
        print("{}\n", sourceCode);

        lexer.LexerState lex;
        lexer.init_lex_state(lex, sourceCode);

        tokens, tokenizationOk, tokenizationError := tokenize(lex);
        
        if (!tokensOk)
                log(stderr, "Error: {}\n", tokenizationError; 
                return;
        }

        for token: tokens) {
                std::print("token type: {token:<20}, Line: {token.line:<10}, Column: {token.column:<10}, vlaue: {token.vlaue:<20}\n");
        }
        
        std::print("Lexing completed successfully.");
        
        state : ParserState = {.tokens = tokens, .pos = 0};
        parser.parse(state);
        print("Parsing completed successfully.");
}